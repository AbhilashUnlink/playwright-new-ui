# Copy to .env (sibling of this file, or at the folder root next to package.json)
# and fill in real values. fixtures/test-config.ts loads both locations by path,
# so it works no matter where playwright is run from.

# Standard login used by most suites.
TEST_USERNAME=
TEST_PASSWORD=

# Pre-onboarded THIRDPARTY (reseller) login for the partner / referral-merchant suites.
TEST_PARTNER_USERNAME=
TEST_PARTNER_PASSWORD=

# Optional overrides — defaults live in fixtures/test-config.ts:
# BASE_URL=https://dev.paymentoptions.com/beta   # target environment (path prefix like /beta is applied to all routes)
# TEST_OTP=1234                                  # fixed e-mail verification code the dev backend accepts
# TEST_GUEST_EMAIL_DOMAIN=example.com            # domain for the unique per-run GUEST sign-up address
# TRANSACTION_COUNT=20                           # rows validated by the transactions suites
# MERCHANT_COUNT=10                              # merchants covered by the merchants e2e suite
# STATEMENT_COUNT=20                             # rows validated by the statements suites
